{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Fictional stack with many deliberate misconfigurations.",
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "customer-records-demo",
        "AccessControl": "PublicRead"
      }
    },
    "WebServerSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Web server",
        "SecurityGroupIngress": [
          { "IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "CidrIp": "0.0.0.0/0" },
          { "IpProtocol": "tcp", "FromPort": 3389, "ToPort": 3389, "CidrIp": "0.0.0.0/0" },
          { "IpProtocol": "tcp", "FromPort": 3306, "ToPort": 3306, "CidrIp": "0.0.0.0/0" },
          { "IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0" }
        ]
      }
    },
    "OpenToWorldSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Allow everything",
        "SecurityGroupIngress": [
          { "IpProtocol": "-1", "CidrIp": "0.0.0.0/0" }
        ]
      }
    },
    "AppDatabase": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceClass": "db.t3.micro",
        "Engine": "mysql",
        "PubliclyAccessible": true,
        "StorageEncrypted": false,
        "BackupRetentionPeriod": 0,
        "MasterUsername": "admin",
        "MasterUserPassword": "SuperSecret123!"
      }
    },
    "AdminPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "admin-all",
        "Roles": ["AppRole"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            { "Effect": "Allow", "Action": "*", "Resource": "*" }
          ]
        }
      }
    },
    "JobQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {}
    }
  }
}
